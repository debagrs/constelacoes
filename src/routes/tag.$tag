import { createFileRoute, Link } from "@tanstack/react-router";
import { useQuery } from "@tanstack/react-query";
import { ArrowLeft, ExternalLink } from "lucide-react";
import { listEntitiesByTag } from "@/lib/data/acervo.functions";
import { SiteHeader } from "@/components/SiteHeader";
import { SiteFooter } from "@/components/SiteFooter";
import { Badge } from "@/components/ui/badge";
import { Skeleton } from "@/components/ui/skeleton";
import { labelForEntityType } from "@/lib/constants";

export const Route = createFileRoute("/tag/$tag")({ component: TagPage });

type Row = {
  id: string; title: string; subtitle: string | null; description: string | null;
  entity_type: string; image_url: string | null; date_display: string | null;
  country: string | null; continent: string | null; culture: string | null;
  source_url: string | null; tags: string; themes: string; metadata: string;
};

function parseRecord(value: string): Record<string, unknown> {
  try { return JSON.parse(value || "{}"); } catch { return {}; }
}

function curatorialNote(row: Row) {
  const metadata = parseRecord(row.metadata);
  const preferred = ["motherhood", "maternidade", "bioethics", "bioetica", "more_than_human", "animal_relations", "care", "cuidado", "curatorial_note", "nota_curatorial"];
  for (const key of preferred) {
    const value = metadata[key];
    if (typeof value === "string" && value.trim()) return value;
    if (Array.isArray(value) && value.length) return value.join(", ");
  }
  return row.description ?? row.subtitle ?? "Registro relacionado a esta perspectiva curatorial.";
}

function TagPage() {
  const { tag } = Route.useParams();
  const decodedTag = decodeURIComponent(tag);
  const { data = [], isLoading } = useQuery({
    queryKey: ["tag", decodedTag],
    queryFn: () => listEntitiesByTag({ data: { tag: decodedTag } }),
  });

  return (
    <div className="flex min-h-screen flex-col">
      <SiteHeader />
      <main className="mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6">
        <Link to="/acervo" className="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground"><ArrowLeft className="h-4 w-4" />Acervo</Link>
        <p className="mt-10 text-eyebrow text-muted-foreground">Perspectiva curatorial</p>
        <h1 className="mt-2 font-display text-4xl font-semibold capitalize">{decodedTag}</h1>
        <p className="mt-3 max-w-3xl text-muted-foreground">Constelação de obras, artistas, conceitos e projetos relacionados a esta tag. Os vínculos sensíveis dependem dos metadados documentados no acervo e não são inferidos pela aparência.</p>
        <p className="mt-4 text-sm text-muted-foreground">{data.length} registros relacionados</p>

        {isLoading ? <div className="mt-8 grid gap-4 md:grid-cols-2">{Array.from({ length: 6 }).map((_, i) => <Skeleton key={i} className="h-44 rounded-xl" />)}</div> : (
          <div className="mt-8 grid gap-4 md:grid-cols-2">
            {(data as Row[]).map((row) => (
              <article key={row.id} className="flex gap-4 rounded-xl border border-border/60 bg-card p-4">
                <Link to="/acervo/$id" params={{ id: row.id }} className="h-28 w-24 shrink-0 overflow-hidden rounded-md bg-muted">
                  {row.image_url ? <img src={row.image_url} alt={row.title} loading="lazy" className="h-full w-full object-cover" /> : <div className="flex h-full items-center justify-center font-display text-3xl text-muted-foreground/50">{row.title.charAt(0)}</div>}
                </Link>
                <div className="min-w-0 flex-1">
                  <div className="flex flex-wrap items-start justify-between gap-2"><div><Link to="/acervo/$id" params={{ id: row.id }} className="font-display text-xl hover:text-primary">{row.title}</Link><p className="mt-0.5 text-xs uppercase tracking-widest text-muted-foreground">{[row.date_display, row.country ?? row.continent].filter(Boolean).join(" · ")}</p></div><Badge variant="secondary" className="text-[0.65rem] uppercase">{labelForEntityType(row.entity_type)}</Badge></div>
                  {row.culture && <Badge variant="outline" className="mt-2 text-[0.65rem]">{row.culture}</Badge>}
                  <p className="mt-3 line-clamp-3 text-sm leading-relaxed text-foreground/80">{curatorialNote(row)}</p>
                  {row.source_url && <a href={row.source_url} target="_blank" rel="noreferrer" className="mt-2 inline-flex items-center gap-1 text-xs text-primary hover:underline">Fonte original <ExternalLink className="h-3 w-3" /></a>}
                </div>
              </article>
            ))}
          </div>
        )}
        {!isLoading && data.length === 0 && <div className="mt-12 rounded-xl border border-dashed p-12 text-center text-muted-foreground">Ainda não há registros publicados com esta tag.</div>}
      </main>
      <SiteFooter />
    </div>
  );
}

